{
  "schema_version": "community-meta-governance-v2",
  "purpose": {
    "optimization_objective": "THEORETICAL_LIMIT_TO_PRODUCTION_GAP",
    "community_knowledge_role": "DISCOVERY_PRIOR_NOT_TARGET_EVIDENCE",
    "success_boundary": "CORRECT_PRODUCTION_WORKLOAD_GAIN_AND_UPSTREAM_VALUE"
  },
  "canonical_repository": {
    "upstream": "https://github.com/dasikuzi2/kernel_opt_agent",
    "working_fork": "https://github.com/adenzhou1350/kernel_opt_agent",
    "repository_role": "SHARED_POLICY_KNOWLEDGE_AND_SCHEMAS",
    "evidence_role": "EXTERNAL_CONTENT_ADDRESSED_RUN_ARTIFACTS"
  },
  "repository_delivery_policy": {
    "fork_sync": {
      "fetch_before_decision": true,
      "push_remote": "fork",
      "push_only_clean_validated_commits": true,
      "review_cadence": "AFTER_MATERIAL_COMMITS_AND_DAILY_WHILE_ACTIVE"
    },
    "upstream_pull_requests": {
      "target_remote": "origin",
      "requires_reviewable_single_scope": true,
      "requires_relevant_tests": true,
      "requires_claim_boundaries": true,
      "forbids_external_experiment_artifacts": true,
      "forbids_hidden_oracle": true,
      "forbids_unverified_performance_claims": true,
      "forbids_monolithic_backlog_pr": true
    }
  },
  "continuity_policy": {
    "local_gate_blocks_only_dependent_actions": true,
    "continue_bounded_safe_work": true,
    "no_material_change_is_silent": true,
    "whole_task_stop_conditions": [
      "FINITE_CYCLE_COMPLETE",
      "USER_PAUSED",
      "STRICT_BLOCKED_AUDIT_SATISFIED"
    ]
  },
  "roles": {
    "control_plane": {
      "single_writer": true,
      "owns": [
        "SEARCH_DEFAULTS",
        "KNOWLEDGE_STRUCTURE",
        "EVALUATION_PROTOCOL",
        "CROSS_FRAMEWORK_PROMOTION"
      ]
    },
    "execution_lanes": ["VLLM", "MOONCAKE", "SGLANG", "STRATEGY_EVALUATION"]
  },
  "evidence_protocol": {
    "work_cycle_schema": "community-work-cycle-v1",
    "paired_trial_schema": "community-ab-report-v1",
    "required_metrics": [
      "CANDIDATE_SOURCE",
      "SEARCH_POLICY_VERSION",
      "WALL_CLOCK_SECONDS",
      "GPU_SECONDS",
      "FAILURE_STAGE",
      "CORRECTNESS",
      "TIME_TO_FIRST_CORRECT",
      "TIME_TO_FIRST_IMPROVEMENT",
      "BEST_SPEEDUP",
      "WHOLE_MODEL_SPEEDUP",
      "UPSTREAM_READY",
      "PULL_REQUEST_STATE",
      "REGRESSION_RATE"
    ]
  },
  "promotion_policy": {
    "comparison": "CHAMPION_VS_CHALLENGER",
    "minimum_frameworks": 2,
    "requires_unseen_candidates": true,
    "improvement_metrics": [
      "TIME_TO_FIRST_CORRECT",
      "TIME_TO_FIRST_IMPROVEMENT",
      "VALIDATION_VALUE_PER_GPU_HOUR",
      "UPSTREAM_READY_OR_MERGE_RATE"
    ],
    "non_regression_metrics": [
      "CORRECTNESS",
      "REGRESSION_RATE",
      "WHOLE_MODEL_SPEEDUP",
      "VALIDATION_COST"
    ],
    "decisions": ["PROMOTE_DEFAULT", "KEEP_LOCAL", "ROLL_BACK"]
  },
  "cycle_contract": {
    "finite_cycles": true,
    "stop_condition": "EVIDENCE_BOUND_CROSS_FRAMEWORK_DECISION_RECORDED"
  }
}
