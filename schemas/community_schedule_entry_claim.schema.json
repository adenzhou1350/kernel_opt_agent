{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_schedule_entry_claim.schema.json",
  "title": "Atomic pre-launch claim for one frozen schedule entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "claimed_at", "claim_boundary", "entry_claim_id",
    "session_id", "state", "order_index", "task_id", "repeat_index", "arm",
    "schedule_key", "sealed_argv_sha256", "resolved_argv",
    "resolved_argv_sha256", "formal_gpu_uuids", "launch_attempt_consumed"
  ],
  "properties": {
    "schema_version": {"const": "community-schedule-entry-claim-v1"},
    "claimed_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "ENTRY_CONSUMED_PRELAUNCH_NO_AUTOMATIC_RETRY"},
    "entry_claim_id": {"$ref": "#/$defs/sha256"},
    "session_id": {"$ref": "#/$defs/sha256"},
    "state": {"const": "CLAIMED_PRELAUNCH"},
    "order_index": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1},
    "arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
    "schedule_key": {"$ref": "#/$defs/sha256"},
    "sealed_argv_sha256": {"$ref": "#/$defs/sha256"},
    "resolved_argv": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "resolved_argv_sha256": {"$ref": "#/$defs/sha256"},
    "formal_gpu_uuids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GPU-[0-9A-Za-z-]+$"}
    },
    "launch_attempt_consumed": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
