{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture_explanation.schema.json",
  "title": "SASS and microarchitecture explanation for an unclosed limit",
  "type": "object",
  "required": ["schema_version", "status", "sass_findings", "microarchitecture_findings", "bounded_residuals", "falsification_tests", "missing_evidence"],
  "properties": {
    "schema_version": {"const": "architecture-explanation-v1"},
    "status": {"enum": ["DRAFT", "VALID", "BLOCKED"]},
    "sass_findings": {"type": "array", "minItems": 1},
    "microarchitecture_findings": {"type": "array", "minItems": 1},
    "bounded_residuals": {"type": "array", "minItems": 1},
    "falsification_tests": {"type": "array", "minItems": 1},
    "missing_evidence": {"type": "array"}
  }
}
