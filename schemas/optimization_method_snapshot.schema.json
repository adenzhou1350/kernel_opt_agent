{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optimization_method_snapshot.schema.json",
  "title": "Cutoff-safe immutable optimization method snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "cutoff_at", "claim_boundary", "library_identity", "included_method_ids", "excluded_method_ids", "excluded_method_count", "withheld_revision_count", "cards"],
  "properties": {
    "schema_version": {"const": "optimization-method-snapshot-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "DISCOVERY_PRIOR_ONLY"},
    "library_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "cards"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}}
      }
    },
    "included_method_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_method_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_method_count": {"type": "integer", "minimum": 0},
    "withheld_revision_count": {"type": "integer", "minimum": 0},
    "cards": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
