{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_materialization_manifest.schema.json",
  "title": "Post-selection task and harness materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "claim_boundary",
    "task",
    "preselection_screen",
    "execution_profile",
    "resource_status",
    "candidate",
    "target_resource_ids",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "community-materialization-manifest-v1",
        "community-materialization-manifest-v2"
      ]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "DECLARED_POST_SELECTION_INPUTS_NOT_EXECUTION_AUTHORITY"},
    "task": {"$ref": "#/$defs/fileIdentity"},
    "preselection_screen": {"$ref": "#/$defs/fileIdentity"},
    "execution_profile": {"$ref": "#/$defs/fileIdentity"},
    "resource_status": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/fileIdentity"}
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pr_number", "purpose", "existing_reference_pr"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pr_number": {"type": "integer", "minimum": 1},
        "purpose": {"enum": ["BLIND_REDISCOVERY", "NEW_UPSTREAM_WORK"]},
        "existing_reference_pr": {
          "type": ["string", "null"],
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
        }
      }
    },
    "target_resource_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hardware_match": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/hardwareMatch"}
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required", "status", "reason", "evidence"],
      "properties": {
        "role": {
          "enum": [
            "BASELINE_SOURCE",
            "OPERATOR_HARNESS",
            "WHOLE_MODEL_HARNESS",
            "MODEL_OR_WEIGHTS",
            "RUNTIME_OR_ENVIRONMENT",
            "LIVE_HARDWARE_STATUS"
          ]
        },
        "required": {"type": "boolean"},
        "status": {"enum": ["READY", "MISSING", "UNVERIFIED", "NOT_APPLICABLE"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/fileIdentity"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "READY"}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {"properties": {"status": {"not": {"const": "NOT_APPLICABLE"}}}}
        }
      ]
    },
    "hardwareMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_names_any",
        "minimum_l2_cache_mib",
        "maximum_l2_cache_mib",
        "required_capabilities_all",
        "maximum_resource_status_age_seconds"
      ],
      "properties": {
        "device_names_any": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "minimum_l2_cache_mib": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "maximum_l2_cache_mib": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "required_capabilities_all": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        },
        "maximum_resource_status_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "community-materialization-manifest-v2"}
        }
      },
      "then": {
        "required": ["hardware_match"],
        "properties": {
          "hardware_match": {"$ref": "#/$defs/hardwareMatch"},
          "resource_status": {"$ref": "#/$defs/fileIdentity"},
          "artifacts": {
            "allOf": [
              {"contains": {"properties": {"role": {"const": "BASELINE_SOURCE"}, "required": {"const": true}}, "required": ["role", "required"]}},
              {"contains": {"properties": {"role": {"const": "OPERATOR_HARNESS"}, "required": {"const": true}}, "required": ["role", "required"]}},
              {"contains": {"properties": {"role": {"const": "WHOLE_MODEL_HARNESS"}, "required": {"const": true}}, "required": ["role", "required"]}},
              {"contains": {"properties": {"role": {"const": "MODEL_OR_WEIGHTS"}, "required": {"const": true}}, "required": ["role", "required"]}},
              {"contains": {"properties": {"role": {"const": "RUNTIME_OR_ENVIRONMENT"}, "required": {"const": true}}, "required": ["role", "required"]}},
              {"contains": {"properties": {"role": {"const": "LIVE_HARDWARE_STATUS"}, "required": {"const": true}}, "required": ["role", "required"]}}
            ]
          }
        }
      }
    }
  ]
}
