{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_atomic_dispatch_result.schema.json",
  "title": "Atomic launch result for one frozen community schedule entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "claim_boundary", "dispatch_result_id",
    "combined_authorization_id", "session_id", "order_index", "schedule_key",
    "entry_claim_id", "dispatch_receipt_id", "terminal_receipt_id", "state",
    "launch_authorized_by_atomic_claim", "automatic_retry_allowed",
    "timeout_seconds", "started_at", "ended_at", "process_exit_code",
    "formal_gpu_uuids", "live_gpu_inventory", "stdout_identity", "stderr_identity"
  ],
  "properties": {
    "schema_version": {"const": "community-atomic-dispatch-result-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {
      "const": "ONE_ATOMIC_LAUNCH_ATTEMPT_NOT_EXPERIMENT_SUCCESS_OR_POLICY_EVIDENCE"
    },
    "dispatch_result_id": {"$ref": "#/$defs/sha256"},
    "combined_authorization_id": {"$ref": "#/$defs/sha256"},
    "session_id": {"$ref": "#/$defs/sha256"},
    "order_index": {"type": "integer", "minimum": 1},
    "schedule_key": {"$ref": "#/$defs/sha256"},
    "entry_claim_id": {"$ref": "#/$defs/sha256"},
    "dispatch_receipt_id": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "terminal_receipt_id": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "state": {
      "enum": [
        "PROCESS_EXITED_AWAITING_VALIDATED_OBSERVATION",
        "TERMINAL_TIMEOUT",
        "TERMINAL_AMBIGUOUS_PRELAUNCH",
        "TERMINAL_AMBIGUOUS_LAUNCH"
      ]
    },
    "launch_authorized_by_atomic_claim": {"const": true},
    "automatic_retry_allowed": {"const": false},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "process_exit_code": {"type": ["integer", "null"]},
    "formal_gpu_uuids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GPU-[0-9A-Za-z-]+$"}
    },
    "live_gpu_inventory": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GPU-[0-9A-Za-z-]+$"}
    },
    "stdout_identity": {"$ref": "#/$defs/identity"},
    "stderr_identity": {"$ref": "#/$defs/identity"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
