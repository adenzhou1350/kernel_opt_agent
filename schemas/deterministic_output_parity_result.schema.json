{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deterministic_output_parity_result.schema.json",
  "title": "Deterministic output parity result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input",
    "contract",
    "baseline_arm",
    "candidate_arm",
    "case_ids",
    "repeat_count",
    "expected_observation_count",
    "observed_observation_count",
    "status",
    "performance_evaluation_allowed",
    "mismatch_count",
    "mismatches"
  ],
  "properties": {
    "schema_version": {"const": "deterministic-output-parity-result-v1"},
    "input": {"$ref": "#/$defs/identity"},
    "contract": {"$ref": "#/$defs/identity"},
    "baseline_arm": {"type": "string", "minLength": 1},
    "candidate_arm": {"type": "string", "minLength": 1},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repeat_count": {"type": "integer", "minimum": 1},
    "expected_observation_count": {"type": "integer", "minimum": 1},
    "observed_observation_count": {"type": "integer", "minimum": 0},
    "status": {"enum": ["PASS", "FAIL"]},
    "performance_evaluation_allowed": {"type": "boolean"},
    "mismatch_count": {"type": "integer", "minimum": 0},
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "arm", "repeat_index", "case_id", "expected_sha256", "observed_sha256"],
        "properties": {
          "reason": {"enum": ["MISSING", "UNEXPECTED", "DUPLICATE", "OUTPUT_MISMATCH"]},
          "arm": {"type": "string", "minLength": 1},
          "repeat_index": {"type": "integer", "minimum": 0},
          "case_id": {"type": "string", "minLength": 1},
          "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "observed_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
