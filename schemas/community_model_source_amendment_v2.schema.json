{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_model_source_amendment_v2.schema.json",
  "title": "Metadata-attested content-equivalent model source amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "cycle_id",
    "task_id",
    "component",
    "logical_model_id",
    "claim_boundary",
    "execution_state",
    "original_source",
    "replacement_source"
  ],
  "properties": {
    "schema_version": {"const": "community-model-source-amendment-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cycle_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "logical_model_id": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "const": "MODEL_TRANSPORT_ONLY_METADATA_ATTESTED_EXECUTOR_PAYLOAD_IDENTICAL_NO_TASK_WORKLOAD_OR_MODEL_CHANGE"
    },
    "execution_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_entries_executed",
        "hidden_oracle_exposed",
        "gpu_dispatch_authorized"
      ],
      "properties": {
        "formal_entries_executed": {"const": 0},
        "hidden_oracle_exposed": {"const": false},
        "gpu_dispatch_authorized": {"const": false}
      }
    },
    "original_source": {"$ref": "#/$defs/metadata_source"},
    "replacement_source": {"$ref": "#/$defs/local_source"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metadata_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "identity_kind", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "bytes": {"type": "integer", "minimum": 1},
        "identity_kind": {"enum": ["GIT_BLOB_SHA1", "LFS_SHA256"]},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
      }
    },
    "excluded_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "category": {
          "enum": [
            "DOCUMENTATION",
            "REPOSITORY_METADATA",
            "NON_EXECUTOR_ALTERNATE_FORMAT"
          ]
        }
      }
    },
    "excluded_local_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "category": {"enum": ["DOCUMENTATION", "PROVIDER_METADATA"]},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metadata_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "revision",
        "metadata_format",
        "metadata_evidence",
        "executor_inventory",
        "excluded_paths"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "metadata_format": {"const": "HUGGINGFACE_MODEL_API_V1"},
        "metadata_evidence": {"$ref": "#/$defs/identity"},
        "executor_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metadata_file"}
        },
        "excluded_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/excluded_path"}
        }
      }
    },
    "local_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "revision",
        "root",
        "executor_inventory",
        "excluded_files"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/relative_path"},
        "executor_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        },
        "excluded_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/excluded_local_file"}
        }
      }
    }
  }
}
