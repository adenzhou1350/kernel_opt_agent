{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification_environment_request.schema.json",
  "title": "Qualification environment reuse request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "platform",
    "execution",
    "candidate_source",
    "allow_native_rebuild"
  ],
  "properties": {
    "schema_version": {"const": "qualification-environment-request-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "required_cpu_features", "gpu_visible"],
      "properties": {
        "os": {"enum": ["linux", "windows", "macos"]},
        "architecture": {"type": "string", "minLength": 1},
        "required_cpu_features": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "gpu_visible": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_sha256",
        "test_contract_sha256",
        "image_digest",
        "dependency_lock_sha256",
        "toolchain_lock_sha256",
        "native_extension_required"
      ],
      "properties": {
        "workflow_sha256": {"$ref": "#/$defs/sha256"},
        "test_contract_sha256": {"$ref": "#/$defs/sha256"},
        "image_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"},
        "native_extension_required": {"type": "boolean"}
      }
    },
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha", "module_sha256"],
      "properties": {
        "tree_sha": {"$ref": "#/$defs/git_sha"},
        "module_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "allow_native_rebuild": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
  }
}
