{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurability_contract.schema.json",
  "title": "Mapping from one decision uncertainty to a defensible observable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "issued_by", "decision_contract_identity",
    "quantity_id", "identifiability", "selected_method", "observable",
    "causal_mapping", "expected_precision", "required_tier", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "measurability-contract-v1"},
    "status": {"enum": ["DRAFT", "READY_FOR_SUPERVISOR", "REJECTED", "CLOSED"]},
    "issued_by": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "analyst_id"],
      "properties": {
        "role": {"const": "MICROARCHITECTURE_ANALYST"},
        "analyst_id": {"type": "string", "minLength": 1}
      }
    },
    "decision_contract_identity": {"$ref": "#/$defs/identity"},
    "quantity_id": {"type": "string", "minLength": 1},
    "identifiability": {"enum": ["ATOMIC_IDENTIFIABLE", "PARTIALLY_IDENTIFIABLE", "NOT_IDENTIFIABLE"]},
    "selected_method": {"enum": ["EXISTING_EVIDENCE", "ATOMIC_MICROBENCH", "CANDIDATE_AB", "NO_MEASUREMENT"]},
    "observable": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unit", "measurement_window"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "measurement_window": {"type": "string", "minLength": 1}
      }
    },
    "causal_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["formula", "assumptions", "confounders", "controls", "falsification_condition"],
      "properties": {
        "formula": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array"},
        "confounders": {"type": "array"},
        "controls": {"type": "array", "minItems": 1},
        "falsification_condition": {"type": "string", "minLength": 1}
      }
    },
    "expected_precision": {
      "type": "object", "additionalProperties": false,
      "required": ["absolute", "unit"],
      "properties": {
        "absolute": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "required_tier": {"enum": ["SCREENING", "QUALIFICATION"]},
    "evidence": {"type": "array"}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": true,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
