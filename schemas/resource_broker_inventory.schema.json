{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource_broker_inventory.schema.json",
  "title": "Shared qualification worker and GPU inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "observed_at", "hosts"],
  "properties": {
    "schema_version": {"const": "resource-broker-inventory-v1"},
    "inventory_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_id",
          "worker_id",
          "state",
          "architecture",
          "capabilities",
          "gpus",
          "environment_closures"
        ],
        "properties": {
          "host_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "worker_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "state": {"enum": ["AVAILABLE", "DRAINING", "UNREACHABLE"]},
          "architecture": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
          },
          "gpus": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uuid", "memory_gib", "state"],
              "properties": {
                "uuid": {"type": "string", "minLength": 1},
                "memory_gib": {"type": "number", "exclusiveMinimum": 0},
                "state": {"enum": ["FREE", "RESERVED_SERVICE", "OFFLINE"]}
              }
            }
          },
          "environment_closures": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    }
  }
}
