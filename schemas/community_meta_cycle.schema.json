{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_meta_cycle.schema.json",
  "title": "Preregistered cross-framework search-policy evaluation cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "declared_at",
    "cutoff_at",
    "claim_boundary",
    "governance_identity",
    "discovery_preregistration_identity",
    "arms",
    "selection",
    "resource_accounting",
    "decision_gate"
  ],
  "properties": {
    "schema_version": {"const": "community-meta-cycle-v1"},
    "cycle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "declared_at": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "CROSS_FRAMEWORK_POLICY_EVALUATION_PROTOCOL_ONLY"},
    "governance_identity": {"$ref": "#/$defs/identity"},
    "discovery_preregistration_identity": {"$ref": "#/$defs/identity"},
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["champion", "challenger"],
      "properties": {
        "champion": {"$ref": "#/$defs/arm"},
        "challenger": {"$ref": "#/$defs/arm"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "minimum_tasks_per_repository",
        "same_task_within_pair",
        "unseen_after_cutoff",
        "repeats"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["sgl-project/sglang", "vllm-project/vllm"]}
        },
        "minimum_tasks_per_repository": {"const": 1},
        "same_task_within_pair": {"const": true},
        "unseen_after_cutoff": {"const": true},
        "repeats": {"type": "integer", "minimum": 2}
      }
    },
    "resource_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_cycle_schema", "gpu_value_definition", "failure_stage_required"],
      "properties": {
        "work_cycle_schema": {"const": "community-work-cycle-v1"},
        "gpu_value_definition": {
          "const": "QUALIFIED_OR_UPSTREAM_READY_SURVIVORS_PER_GPU_HOUR"
        },
        "failure_stage_required": {"const": true}
      }
    },
    "decision_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_frameworks",
        "improve_any",
        "must_not_regress",
        "allowed_decisions"
      ],
      "properties": {
        "minimum_frameworks": {"const": 2},
        "improve_any": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TIME_TO_FIRST_CORRECT",
              "TIME_TO_FIRST_IMPROVEMENT",
              "VALIDATION_VALUE_PER_GPU_HOUR",
              "UPSTREAM_READY_OR_MERGE_RATE"
            ]
          }
        },
        "must_not_regress": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CORRECTNESS",
              "REGRESSION_RATE",
              "WHOLE_MODEL_SPEEDUP",
              "VALIDATION_COST"
            ]
          }
        },
        "allowed_decisions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["PROMOTE_DEFAULT", "KEEP_LOCAL", "ROLL_BACK"]}
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_arm", "policy_id", "policy"],
      "properties": {
        "protocol_arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
        "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "policy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
