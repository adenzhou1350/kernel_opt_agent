{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_materialized_resource_status.schema.json",
  "title": "Point-in-time resource identity for post-materialization gating",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "claim_boundary",
    "resources",
    "actions"
  ],
  "properties": {
    "schema_version": {"const": "community-materialized-resource-status-v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "POINT_IN_TIME_READ_ONLY_OBSERVATION"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "availability",
          "vendor",
          "device_name",
          "architecture",
          "memory_gib_per_gpu",
          "l2_cache_mib",
          "gpu_indices",
          "excluded_gpu_indices",
          "active_compute_process_count"
        ],
        "properties": {
          "resource_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "availability": {
            "enum": [
              "AVAILABLE",
              "RESERVED",
              "SHARED_NO_DISRUPTION",
              "UNREACHABLE"
            ]
          },
          "vendor": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "device_name": {"type": "string", "minLength": 1},
          "architecture": {"type": "string", "minLength": 1},
          "memory_gib_per_gpu": {"type": "number", "exclusiveMinimum": 0},
          "l2_cache_mib": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "gpu_indices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "excluded_gpu_indices": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "active_compute_process_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processes_stopped", "gpu_benchmarks_started", "compilations_started"],
      "properties": {
        "processes_stopped": {"type": "integer", "minimum": 0},
        "gpu_benchmarks_started": {"type": "integer", "minimum": 0},
        "compilations_started": {"type": "integer", "minimum": 0}
      }
    }
  }
}
