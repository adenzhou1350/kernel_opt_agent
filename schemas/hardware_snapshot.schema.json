{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware_snapshot.schema.json",
  "title": "Target hardware snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "captured_at", "host", "target", "software", "tools", "provenance"],
  "properties": {
    "schema_version": {"const": "hardware-snapshot-v1"},
    "captured_at": {"type": "string", "format": "date-time"},
    "host": {"type": "object"},
    "target": {
      "type": "object",
      "required": ["vendor", "device_name", "device_index"],
      "properties": {
        "vendor": {"type": "string"},
        "device_name": {"type": "string"},
        "device_index": {"type": "integer", "minimum": 0},
        "uuid": {"type": "string"},
        "architecture": {"type": "string"},
        "sm_count": {"type": ["integer", "null"]},
        "memory_bytes": {"type": ["integer", "null"]},
        "warp_size": {"type": ["integer", "null"]},
        "registers_per_sm": {"type": ["integer", "null"]},
        "shared_memory_per_sm_bytes": {"type": ["integer", "null"]},
        "shared_memory_per_block_bytes": {"type": ["integer", "null"]}
      }
    },
    "software": {"type": "object"},
    "power_clock": {"type": "object"},
    "tools": {"type": "object"},
    "competing_load": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["queries"],
      "properties": {"queries": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
