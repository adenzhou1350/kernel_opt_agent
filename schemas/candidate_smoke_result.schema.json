{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_smoke_result.schema.json",
  "title": "Discovery-only candidate smoke result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "candidate_id", "objective", "cases"],
  "properties": {
    "schema_version": {"const": "candidate-smoke-result-v1"},
    "status": {"const": "PASS"},
    "candidate_id": {"type": "string", "minLength": 1},
    "objective": {
      "type": "object",
      "required": ["direction", "baseline", "candidate", "unit"]
    },
    "cases": {"type": "array", "minItems": 2}
  }
}
