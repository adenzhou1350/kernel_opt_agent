{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_smoke_result.schema.json",
  "title": "Discovery-only candidate smoke result with execution-path proof",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "candidate_id", "objective", "cases", "correctness", "reachability", "runtime_contract", "timing_accounting"],
  "properties": {
    "schema_version": {"const": "candidate-smoke-result-v5"},
    "status": {"const": "PASS"},
    "candidate_id": {"type": "string", "minLength": 1},
    "objective": {
      "type": "object",
      "required": ["direction", "baseline", "candidate", "unit", "measurement_window"],
      "properties": {
        "measurement_window": {"enum": ["STEADY_STATE_ONLY", "END_TO_END_WITH_SETUP"]}
      }
    },
    "cases": {"type": "array", "minItems": 2},
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contract", "oracle", "case_results"],
      "properties": {
        "status": {"const": "PASS"},
        "contract": {"enum": ["EXACT_IDENTITY", "TOLERANCE_BOUNDED", "PROPERTY_BASED"]},
        "oracle": {"type": "string", "minLength": 1},
        "case_results": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "role", "status", "baseline_digest", "candidate_digest", "evidence"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "role": {"enum": ["ANCHOR", "EDGE"]},
              "status": {"const": "PASS"},
              "baseline_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "candidate_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "reachability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "expected_path", "observed_path", "compile_cache_policy", "execution_proof", "evidence"],
      "properties": {
        "status": {"const": "PASS"},
        "expected_path": {"type": "string", "minLength": 1},
        "observed_path": {"type": "string", "minLength": 1},
        "compile_cache_policy": {"enum": ["FRESH", "SOURCE_HASHED", "NOT_COMPILED"]},
        "execution_proof": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind", "scope", "observed_count", "minimum_count", "evidence_index"],
          "properties": {
            "kind": {"enum": ["KERNEL_INSTANCE_COUNT", "INSTRUMENTED_CALL_COUNT", "DIRECT_SENTINEL"]},
            "scope": {"type": "string", "minLength": 1},
            "observed_count": {"type": "integer", "minimum": 1},
            "minimum_count": {"type": "integer", "minimum": 1},
            "evidence_index": {"type": "integer", "minimum": 0}
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_execution_mode", "observed_execution_mode", "treatment_materialization", "compile_cache_key_includes_treatment", "requires_logical_extent", "logical_extent_source", "treatment_identity_evidence_index"],
      "properties": {
        "production_execution_mode": {"enum": ["EAGER", "COMPILED", "CUDA_GRAPH"]},
        "observed_execution_mode": {"enum": ["EAGER", "COMPILED", "CUDA_GRAPH"]},
        "treatment_materialization": {"enum": ["SOURCE_FILE", "GENERATED_ARTIFACT", "RUNTIME_MONKEYPATCH", "DIRECT_CALL"]},
        "compile_cache_key_includes_treatment": {"type": "boolean"},
        "requires_logical_extent": {"type": "boolean"},
        "logical_extent_source": {"enum": ["EXPLICIT_RUNTIME_METADATA", "STATIC_SPECIALIZATION", "PHYSICAL_TENSOR_SHAPE", "NOT_APPLICABLE"]},
        "treatment_identity_evidence_index": {"type": "integer", "minimum": 0}
      }
    },
    "timing_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup_seconds", "compile_seconds", "warmup_seconds", "steady_state_seconds", "steady_state_samples", "objective_window", "process_model", "persistent_session_eligible", "switching_preserves_treatment_identity"],
      "properties": {
        "setup_seconds": {"type": "number", "minimum": 0},
        "compile_seconds": {"type": "number", "minimum": 0},
        "warmup_seconds": {"type": "number", "minimum": 0},
        "steady_state_seconds": {"type": "number", "exclusiveMinimum": 0},
        "steady_state_samples": {"type": "integer", "minimum": 1},
        "objective_window": {"enum": ["STEADY_STATE_ONLY", "END_TO_END_WITH_SETUP"]},
        "process_model": {"enum": ["COLD_PER_ARM", "PERSISTENT_SHARED_ENGINE", "PERSISTENT_PER_ARM"]},
        "persistent_session_eligible": {"type": "boolean"},
        "switching_preserves_treatment_identity": {"type": "boolean"}
      }
    }
  }
}
