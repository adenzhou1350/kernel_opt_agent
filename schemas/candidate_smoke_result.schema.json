{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_smoke_result.schema.json",
  "title": "Discovery-only candidate smoke result with execution-path proof",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "candidate_id", "objective", "cases", "reachability"],
  "properties": {
    "schema_version": {"const": "candidate-smoke-result-v2"},
    "status": {"const": "PASS"},
    "candidate_id": {"type": "string", "minLength": 1},
    "objective": {
      "type": "object",
      "required": ["direction", "baseline", "candidate", "unit"]
    },
    "cases": {"type": "array", "minItems": 2},
    "reachability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "expected_path", "observed_path", "compile_cache_policy", "evidence"],
      "properties": {
        "status": {"const": "PASS"},
        "expected_path": {"type": "string", "minLength": 1},
        "observed_path": {"type": "string", "minLength": 1},
        "compile_cache_policy": {"enum": ["FRESH", "SOURCE_HASHED", "NOT_COMPILED"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
