{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_import_preflight_request.schema.json",
  "title": "Runtime import preflight request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "interpreter",
    "working_directory",
    "python_paths",
    "environment_overrides",
    "timeout_seconds",
    "imports"
  ],
  "properties": {
    "schema_version": {"const": "runtime-import-preflight-request-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "interpreter": {"$ref": "#/$defs/file_identity"},
    "working_directory": {"type": "string", "minLength": 1},
    "python_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "environment_overrides": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "imports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "import_id",
          "module",
          "attribute",
          "expected_module_file",
          "expected_attribute_module",
          "forbidden_loaded_module_prefixes"
        ],
        "properties": {
          "import_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
          "attribute": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "expected_module_file": {"$ref": "#/$defs/file_identity"},
          "expected_attribute_module": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
          "forbidden_loaded_module_prefixes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
