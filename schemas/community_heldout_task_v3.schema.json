{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_heldout_task_v3.schema.json",
  "title": "Machine-complete, user-confirmed symptom-only held-out optimization task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "information_policy",
    "intake_confirmation",
    "objective",
    "operator",
    "workload",
    "hardware",
    "baseline",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": "community-heldout-task-v3"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "information_policy": {"const": "SYMPTOM_CONTRACT_AND_BASELINE_ONLY"},
    "intake_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_at", "confirmed_by", "confirmed_scopes"],
      "properties": {
        "status": {"const": "USER_CONFIRMED"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_scopes": {
          "type": "array",
          "const": ["OPERATOR", "WORKLOAD", "HARDWARE"]
        }
      }
    },
    "objective": {"type": "string", "minLength": 1},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computation",
        "tensor_roles",
        "input_shapes",
        "strides",
        "input_dtypes",
        "output_dtypes",
        "state_transitions",
        "masks_and_boundaries",
        "layout",
        "numerical_contract",
        "aliasing",
        "lifetimes",
        "public_abi",
        "legal_rewrites",
        "forbidden_rewrites"
      ],
      "properties": {
        "computation": {"type": "string", "minLength": 1},
        "tensor_roles": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "input_shapes": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "strides": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "input_dtypes": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "output_dtypes": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "state_transitions": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "masks_and_boundaries": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "layout": {"type": "string", "minLength": 1},
        "numerical_contract": {"type": "string", "minLength": 1},
        "aliasing": {"type": "string", "minLength": 1},
        "lifetimes": {"type": "string", "minLength": 1},
        "public_abi": {"type": "string", "minLength": 1},
        "legal_rewrites": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "forbidden_rewrites": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_mode",
        "shape_weights",
        "execution_modes",
        "upstream_layouts",
        "downstream_layouts",
        "call_frequency",
        "graph_capture_state",
        "concurrency",
        "cache_semantics",
        "latency_objective",
        "required_controls"
      ],
      "properties": {
        "primary_mode": {"type": "string", "minLength": 1},
        "shape_weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        },
        "execution_modes": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "upstream_layouts": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "downstream_layouts": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "call_frequency": {"type": "string", "minLength": 1},
        "graph_capture_state": {"type": "string", "minLength": 1},
        "concurrency": {"type": "string", "minLength": 1},
        "cache_semantics": {"type": "string", "minLength": 1},
        "latency_objective": {"type": "string", "minLength": 1},
        "required_controls": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "compute_capability",
        "memory_gib",
        "driver",
        "runtime",
        "compiler",
        "power_clock_policy",
        "profilers",
        "disassemblers",
        "allowed_programming_models",
        "architecture_specific_implementation_allowed"
      ],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "compute_capability": {"type": "string", "minLength": 1},
        "memory_gib": {"type": "number", "exclusiveMinimum": 0},
        "driver": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "power_clock_policy": {"type": "string", "minLength": 1},
        "profilers": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "disassemblers": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "allowed_programming_models": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "architecture_specific_implementation_allowed": {"type": "boolean"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "observed_symptom", "bottleneck_status", "claim_boundary"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "observed_symptom": {"type": "string", "minLength": 1},
        "candidate_bottlenecks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "bottleneck_status": {"type": "string", "minLength": 1},
        "claim_boundary": {"const": "TASK_INPUT_NOT_RESULT"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "performance", "integration", "upstream"],
      "properties": {
        "correctness": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "performance": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "integration": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "upstream": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
