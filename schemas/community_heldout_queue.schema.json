{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_heldout_queue.schema.json",
  "title": "Deterministic cutoff-safe held-out PR selection queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "cutoff_at",
    "claim_boundary",
    "input_identity",
    "policy",
    "inventory",
    "items",
    "excluded"
  ],
  "properties": {
    "schema_version": {"const": "community-heldout-queue-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "DISCOVERY_METADATA_SELECTION_ONLY"},
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipts", "training_graph", "training_methods", "corpus_index_sha256"],
      "properties": {
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileIdentity"}
        },
        "training_graph": {"$ref": "#/$defs/fileIdentity"},
        "training_methods": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/fileIdentity"}
          ]
        },
        "corpus_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "random_seed",
        "required_receipt_schema",
        "eligibility_time_field",
        "exclude_training_sources",
        "selection_inputs",
        "ordering"
      ],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1, "maximum": 100},
        "random_seed": {"type": "integer", "minimum": 0},
        "required_receipt_schema": {"const": "community-sync-receipt-v2"},
        "eligibility_time_field": {"const": "earliest_public_at"},
        "exclude_training_sources": {"const": true},
        "selection_inputs": {
          "const": ["repository", "pr_number", "classifications", "selection_score", "earliest_public_at"]
        },
        "ordering": {"const": "DIVERSE_GROUP_FIRST_THEN_DISCOVERY_SCORE_THEN_SEEDED_HASH"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_candidate_count",
        "deduplicated_count",
        "eligible_count",
        "selected_count",
        "backlog_count",
        "excluded_pre_cutoff_count",
        "excluded_training_source_count"
      ],
      "properties": {
        "receipt_candidate_count": {"type": "integer", "minimum": 0},
        "deduplicated_count": {"type": "integer", "minimum": 0},
        "eligible_count": {"type": "integer", "minimum": 0},
        "selected_count": {"type": "integer", "minimum": 0},
        "backlog_count": {"type": "integer", "minimum": 0},
        "excluded_pre_cutoff_count": {"type": "integer", "minimum": 0},
        "excluded_training_source_count": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "pr_number", "earliest_public_at", "reason"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "pr_number": {"type": "integer", "minimum": 1},
          "earliest_public_at": {"type": "string", "format": "date-time"},
          "reason": {"enum": ["PRE_CUTOFF_PUBLIC", "TRAINING_SOURCE"]}
        }
      }
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pr_number",
        "title",
        "earliest_public_at",
        "updated_at",
        "classifications",
        "discovery_score",
        "diversity_group",
        "within_group_rank",
        "seeded_tiebreak",
        "selection",
        "priority_rank"
      ],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pr_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "earliest_public_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z_]+$"}
        },
        "discovery_score": {"type": "integer", "minimum": 1},
        "diversity_group": {"type": "string", "minLength": 1},
        "within_group_rank": {"type": "integer", "minimum": 1},
        "seeded_tiebreak": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection": {"enum": ["SELECTED", "BACKLOG"]},
        "priority_rank": {"type": "integer", "minimum": 1}
      }
    }
  }
}
