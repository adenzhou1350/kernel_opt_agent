{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_corpus_index.schema.json",
  "title": "Community optimization evidence corpus index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "snapshots"],
  "properties": {
    "schema_version": {"const": "community-corpus-index-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "repository",
          "pr_number",
          "snapshot_id",
          "path",
          "manifest_sha256",
          "source_updated_at",
          "lifecycle"
        ],
        "properties": {
          "provider": {"const": "github"},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "pr_number": {"type": "integer", "minimum": 1},
          "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
          "path": {"type": "string", "minLength": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_updated_at": {"type": "string", "format": "date-time"},
          "lifecycle": {"enum": ["OPEN", "MERGED", "CLOSED_UNMERGED"]}
        }
      }
    }
  }
}
