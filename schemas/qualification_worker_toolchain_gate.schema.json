{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification_worker_toolchain_gate.schema.json",
  "title": "Fresh worker tool availability before a GPU lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "claim_boundary",
    "worker_id",
    "host_id",
    "attestation",
    "consumer",
    "attestation_observed_at",
    "max_age_seconds",
    "attestation_age_seconds",
    "tools",
    "blockers",
    "lease_authorized",
    "execution_authorized",
    "gpu_authorized"
  ],
  "properties": {
    "schema_version": {"const": "qualification-worker-toolchain-gate-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["READY_FOR_PRELEASE_BINDING", "BLOCKED_PRELEASE"]},
    "claim_boundary": {"const": "FRESH_WORKER_TOOL_AVAILABILITY_ONLY_NOT_LEASE_EXECUTION_GPU_CORRECTNESS_OR_PERFORMANCE_AUTHORIZATION"},
    "worker_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "attestation": {"$ref": "#/$defs/identity"},
    "consumer": {"$ref": "#/$defs/identity"},
    "attestation_observed_at": {"type": "string", "format": "date-time"},
    "max_age_seconds": {"type": "integer", "minimum": 1},
    "attestation_age_seconds": {"type": "number", "minimum": 0},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "identity"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]*$"},
          "state": {"enum": ["PRESENT", "MISSING"]},
          "identity": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/tool"}
            ]
          }
        }
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lease_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "gpu_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
