{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware_evidence_manifest.schema.json",
  "title": "Trusted-policy and target-bound hardware evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "target_identity", "trusted_policy_identity",
    "official_source_policy", "required_document_roles", "sources", "facts",
    "empirical_measurements", "unknowns", "developer_input_request"
  ],
  "properties": {
    "schema_version": {"const": "hardware-evidence-manifest-v2"},
    "status": {"enum": ["READY", "BLOCKED"]},
    "target_identity": {
      "type": "object", "additionalProperties": true,
      "required": ["vendor", "device_name"],
      "properties": {
        "vendor": {"type": "string", "minLength": 1},
        "device_name": {"type": "string", "minLength": 1}
      }
    },
    "trusted_policy_identity": {"$ref": "#/$defs/identity"},
    "official_source_policy": {
      "type": "object", "additionalProperties": true,
      "required": ["vendor", "allowed_official_domains", "policy"]
    },
    "required_document_roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "source_id", "role", "authority", "title", "version", "locator",
          "applicability", "role_review", "url", "retrieval"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "authority": {"const": "VENDOR_OFFICIAL_DOCUMENT"},
          "title": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "locator": {"$ref": "#/$defs/locator"},
          "applicability": {
            "type": "object", "additionalProperties": false,
            "required": ["vendor", "compute_capabilities", "device_models"],
            "properties": {
              "vendor": {"type": "string", "minLength": 1},
              "compute_capabilities": {"type": "array", "items": {"type": "string"}},
              "device_models": {"type": "array", "items": {"type": "string"}}
            }
          },
          "role_review": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "reviewer", "reviewed_at", "claim"],
            "properties": {
              "status": {"const": "APPROVED"},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"},
              "claim": {"type": "string", "minLength": 1}
            }
          },
          "url": {"type": "string", "pattern": "^https://"},
          "retrieval": {
            "type": "object", "additionalProperties": false,
            "required": [
              "method", "retrieved_at", "retriever", "requested_url", "final_url",
              "http_status", "artifact_path", "sha256", "receipt_path", "receipt_sha256"
            ],
            "properties": {
              "method": {"const": "AGENT_HTTPS_DOWNLOAD"},
              "retrieved_at": {"type": "string", "format": "date-time"},
              "retriever": {"type": "string", "minLength": 1},
              "requested_url": {"type": "string", "pattern": "^https://"},
              "final_url": {"type": "string", "pattern": "^https://"},
              "http_status": {"const": 200},
              "artifact_path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "receipt_path": {"type": "string", "minLength": 1},
              "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "fact_id", "scope", "field", "value", "unit", "evidence_class",
          "source_id", "locator", "semantic_review"
        ],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["ARCHITECTURE", "DEVICE_MODEL", "TARGET_DEVICE"]},
          "field": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "evidence_class": {"const": "DOCUMENTED_FACT"},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"$ref": "#/$defs/locator"},
          "semantic_review": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "reviewer", "reviewed_at", "claim"],
            "properties": {
              "status": {"const": "APPROVED"},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"},
              "claim": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "empirical_measurements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["measurement_id", "evidence_class", "identity"],
        "properties": {
          "measurement_id": {"type": "string", "minLength": 1},
          "evidence_class": {"const": "TARGET_MEASUREMENT"},
          "identity": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "unknowns": {"type": "array"},
    "developer_input_request": {"type": ["object", "null"]}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value", "support_text", "support_text_sha256"],
      "properties": {
        "kind": {"enum": ["SECTION", "TABLE", "HTML_ANCHOR", "TEXT"]},
        "value": {"type": "string", "minLength": 1},
        "support_text": {"type": "string", "minLength": 1},
        "support_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
