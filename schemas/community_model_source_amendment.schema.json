{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_model_source_amendment.schema.json",
  "title": "Content-equivalent model source amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "cycle_id",
    "task_id",
    "component",
    "logical_model_id",
    "claim_boundary",
    "execution_state",
    "original_source",
    "replacement_source"
  ],
  "properties": {
    "schema_version": {"const": "community-model-source-amendment-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cycle_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "logical_model_id": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "const": "MODEL_TRANSPORT_ONLY_EXECUTOR_PAYLOAD_CONTENT_IDENTICAL_NO_TASK_WORKLOAD_OR_MODEL_CHANGE"
    },
    "execution_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_entries_executed",
        "hidden_oracle_exposed",
        "gpu_dispatch_authorized"
      ],
      "properties": {
        "formal_entries_executed": {"const": 0},
        "hidden_oracle_exposed": {"const": false},
        "gpu_dispatch_authorized": {"const": false}
      }
    },
    "original_source": {"$ref": "#/$defs/source"},
    "replacement_source": {"$ref": "#/$defs/source"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "excluded_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "category": {"enum": ["DOCUMENTATION", "PROVIDER_METADATA"]},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "revision",
        "root",
        "executor_inventory",
        "excluded_files"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/relative_path"},
        "executor_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        },
        "excluded_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/excluded_file"}
        }
      }
    }
  }
}
