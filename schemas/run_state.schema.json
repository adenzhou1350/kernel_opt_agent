{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_state.schema.json",
  "title": "Evidence-closed optimization run state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework_contract_version", "run_id", "completed_phases", "current_phase", "allowed_next_phase", "next_action", "terminal"],
  "properties": {
    "schema_version": {"const": "optimization-run-state-v4"},
    "framework_contract_version": {"const": "evidence-closed-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "completed_phases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/phase"}},
    "current_phase": {"$ref": "#/$defs/phase"},
    "allowed_next_phase": {"enum": ["PLANNING", "BASELINE", "MODELING", "EXPERIMENT", "PRODUCTION_VALIDATION", "CERTIFICATION", "COMPLETE", null]},
    "next_action": {"type": "string", "minLength": 1},
    "terminal": {"type": "boolean"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "phase": {"type": "string", "enum": ["INTAKE", "PLANNING", "BASELINE", "MODELING", "EXPERIMENT", "PRODUCTION_VALIDATION", "CERTIFICATION", "COMPLETE"]}
  }
}
