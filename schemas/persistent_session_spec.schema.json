{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persistent_session_spec.schema.json",
  "title": "Bounded persistent worker session specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "argv", "cwd", "session_scope", "expected_session_identity", "startup_timeout_seconds", "request_timeout_seconds", "shutdown_timeout_seconds", "requests"],
  "properties": {
    "schema_version": {"const": "persistent-session-spec-v1"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cwd": {"type": "string", "minLength": 1},
    "session_scope": {"enum": ["SINGLE_TREATMENT", "SHARED_TREATMENTS"]},
    "expected_session_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "startup_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "shutdown_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "treatment_identity", "payload"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "treatment_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "payload": {"type": "object"}
        }
      }
    }
  }
}
