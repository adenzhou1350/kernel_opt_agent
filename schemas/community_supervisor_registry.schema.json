{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_supervisor_registry.schema.json",
  "title": "Frozen trusted supervisors for one community evaluation cycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "cycle_id", "claim_boundary", "supervisors"],
  "properties": {
    "schema_version": {"const": "community-supervisor-registry-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cycle_id": {"type": "string", "minLength": 1},
    "claim_boundary": {"const": "FROZEN_TRUST_REGISTRY_NOT_APPROVAL"},
    "supervisors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["supervisor_id", "role", "status", "authorities"],
        "properties": {
          "supervisor_id": {"type": "string", "minLength": 1},
          "role": {"const": "GLOBAL_SUPERVISOR"},
          "status": {"enum": ["ACTIVE", "REVOKED"]},
          "authorities": {
            "type": "array",
            "uniqueItems": true,
            "contains": {"const": "APPROVE_COMMUNITY_COHORT_DISPATCH"},
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
