{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_action_attestation.schema.json",
  "title": "Current-state attestation for one declared active delivery action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_boundary",
    "generated_at",
    "valid_until",
    "ledger_identity",
    "cycle_id",
    "span_id",
    "state",
    "action_owner",
    "resource_id",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "community-action-attestation-v1"},
    "claim_boundary": {"const": "CURRENT_ACTION_STATE_ONLY_NOT_LEDGER_MUTATION"},
    "generated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "ledger_identity": {"$ref": "#/$defs/identity"},
    "cycle_id": {"type": "string", "minLength": 1},
    "span_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["ACTIVE", "RESOLVED", "SUPERSEDED"]},
    "action_owner": {
      "enum": ["USER", "AGENT", "EXTERNAL", "MAINTAINER", "GPU", "NONE"]
    },
    "resource_id": {"type": ["string", "null"], "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identity"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
