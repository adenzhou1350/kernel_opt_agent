{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_opportunity_ranking.schema.json",
  "title": "Pre-implementation architecture opportunity ranking",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at_seconds", "claim_boundary", "contract_identity", "diagnosis", "architectures", "prior_gate"],
  "properties": {
    "schema_version": {"const": "community-opportunity-ranking-v1"},
    "created_at_seconds": {"type": "number", "minimum": 0},
    "claim_boundary": {"const": "PRE_IMPLEMENTATION_HYPOTHESES_ONLY"},
    "contract_identity": {"$ref": "#/$defs/identity"},
    "diagnosis": {"type": "string", "minLength": 1},
    "architectures": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/architecture"}
    },
    "prior_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis_confidence", "leading_local_candidate", "expected_ceiling", "largest_unresolved_risk", "knowledge_positive_expected_value"],
      "properties": {
        "diagnosis_confidence": {"enum": ["low", "medium", "high"]},
        "leading_local_candidate": {"type": "string", "minLength": 1},
        "expected_ceiling": {"type": "string", "minLength": 1},
        "largest_unresolved_risk": {"type": "string", "minLength": 1},
        "knowledge_positive_expected_value": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_id", "rank", "name", "dimension_ids", "partition_axis", "upper_bound"],
      "properties": {
        "architecture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "rank": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "dimension_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["launch-materialization", "work-decomposition", "shape-path-specialization"]}},
        "partition_axis": {"type": "string", "minLength": 1},
        "upper_bound": {"$ref": "#/$defs/bound"}
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "maximum_speedup", "rationale"],
      "properties": {
        "kind": {"enum": ["QUANTIFIED", "STRUCTURAL", "UNKNOWN"]},
        "maximum_speedup": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "QUANTIFIED"}}},
          "then": {"properties": {"maximum_speedup": {"type": "number", "exclusiveMinimum": 0}}},
          "else": {"properties": {"maximum_speedup": {"type": "null"}}}
        }
      ]
    }
  }
}
