{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_evaluation_trial.schema.json",
  "title": "Materialized community-knowledge evaluation trial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "created_at",
    "suite_identity",
    "suite_id",
    "task_id",
    "repeat_index",
    "arm",
    "status",
    "budget",
    "success_thresholds",
    "access_policy",
    "source_checkout",
    "task_input",
    "prompt_input",
    "environment_input",
    "result_contract",
    "executor_prompt",
    "community_graph"
  ],
  "properties": {
    "schema_version": {"const": "community-evaluation-trial-v1"},
    "trial_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "suite_identity": {"$ref": "#/$defs/identity"},
    "suite_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1},
    "arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
    "status": {"const": "MATERIALIZED"},
    "budget": {"type": "object"},
    "success_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_material_speedup"],
      "properties": {
        "minimum_material_speedup": {"type": "number", "exclusiveMinimum": 1}
      }
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "community_knowledge"],
      "properties": {
        "network": {"const": "DISABLED"},
        "community_knowledge": {"enum": ["WITHHELD", "FROZEN_GRAPH_ONLY"]}
      }
    },
    "source_checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "task_input": {"$ref": "#/$defs/identity"},
    "prompt_input": {"$ref": "#/$defs/identity"},
    "environment_input": {"$ref": "#/$defs/identity"},
    "result_contract": {"$ref": "#/$defs/identity"},
    "executor_prompt": {"$ref": "#/$defs/identity"},
    "task_support": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "community_graph": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
