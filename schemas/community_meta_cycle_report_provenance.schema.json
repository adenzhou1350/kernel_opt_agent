{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_meta_cycle_report_provenance.schema.json",
  "title": "Authorization provenance wrapper for a community meta-cycle report",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "claim_boundary", "report", "combined_authorization", "observation_provenance"],
  "properties": {
    "schema_version": {"const": "community-meta-cycle-report-provenance-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "FINAL_REPORT_WITH_AUTHORIZED_DISPATCH_PROVENANCE"},
    "report": {"$ref": "#/$defs/identity"},
    "combined_authorization": {"$ref": "#/$defs/identity"},
    "observation_provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
  },
  "$defs": {"identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
