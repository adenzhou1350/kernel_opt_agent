{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment_cache_preflight_request.schema.json",
  "title": "Environment cache preflight request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "cache_roots"],
  "properties": {
    "schema_version": {"const": "environment-cache-preflight-request-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "cache_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cache_id",
          "path",
          "environment_variable",
          "minimum_free_bytes",
          "require_existing",
          "require_writable",
          "write_probe_authorized"
        ],
        "properties": {
          "cache_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "path": {"type": "string", "minLength": 1},
          "environment_variable": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "minimum_free_bytes": {"type": "integer", "minimum": 0},
          "require_existing": {"type": "boolean"},
          "require_writable": {"type": "boolean"},
          "write_probe_authorized": {"type": "boolean"}
        }
      }
    }
  }
}
