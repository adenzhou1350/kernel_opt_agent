{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_combined_execution_authorization_v2.schema.json",
  "title": "Store-bound P-and-E-and-A authorization ready for atomic consumption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "claim_boundary",
    "combined_authorization_id", "validator_binding",
    "authorization_request", "semantic_supervisor_approval",
    "claim_store_deployment", "cycle_id", "suite_id",
    "formal_resource_id", "execution_schedule", "gate_decisions", "state",
    "ready_for_atomic_claim", "gpu_dispatch_authorized",
    "remaining_blockers", "hidden_oracle_exposed"
  ],
  "properties": {
    "schema_version": {"const": "community-combined-execution-authorization-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "P_AND_E_AND_A_AND_STORE_RECOMPUTED_READY_FOR_ATOMIC_CLAIM_NOT_DISPATCH"},
    "combined_authorization_id": {"$ref": "#/$defs/sha256"},
    "validator_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_commit", "authorization_schema_sha256",
        "request_schema_sha256", "approval_schema_sha256",
        "deployment_schema_sha256", "validator_sha256",
        "semantic_validator_sha256", "deployment_validator_sha256",
        "pre_gpu_validator_sha256", "execution_validator_sha256",
        "claim_contracts_sha256", "atomic_claim_sha256"
      ],
      "properties": {
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "authorization_schema_sha256": {"$ref": "#/$defs/sha256"},
        "request_schema_sha256": {"$ref": "#/$defs/sha256"},
        "approval_schema_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_schema_sha256": {"$ref": "#/$defs/sha256"},
        "validator_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_validator_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_validator_sha256": {"$ref": "#/$defs/sha256"},
        "pre_gpu_validator_sha256": {"$ref": "#/$defs/sha256"},
        "execution_validator_sha256": {"$ref": "#/$defs/sha256"},
        "claim_contracts_sha256": {"$ref": "#/$defs/sha256"},
        "atomic_claim_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization_request": {"$ref": "#/$defs/identity"},
    "semantic_supervisor_approval": {"$ref": "#/$defs/identity"},
    "claim_store_deployment": {"$ref": "#/$defs/identity"},
    "cycle_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "formal_resource_id": {"type": "string", "minLength": 1},
    "execution_schedule": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/execution_entry"}
    },
    "gate_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_gpu_ready", "execution_contract_ready",
        "semantic_approval_ready", "claim_store_deployment_ready"
      ],
      "properties": {
        "pre_gpu_ready": {"type": "boolean"},
        "execution_contract_ready": {"type": "boolean"},
        "semantic_approval_ready": {"type": "boolean"},
        "claim_store_deployment_ready": {"type": "boolean"}
      }
    },
    "state": {"enum": ["READY_FOR_ATOMIC_CLAIM", "ATOMIC_CLAIM_BLOCKED"]},
    "ready_for_atomic_claim": {"type": "boolean"},
    "gpu_dispatch_authorized": {"const": false},
    "remaining_blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hidden_oracle_exposed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_index", "task_id", "repeat_index", "arm", "schedule_key",
        "sealed_argv_sha256", "resolved_argv", "resolved_argv_sha256",
        "formal_gpu_uuids"
      ],
      "properties": {
        "order_index": {"type": "integer", "minimum": 1},
        "task_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1},
        "arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
        "schedule_key": {"$ref": "#/$defs/sha256"},
        "sealed_argv_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_argv": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "resolved_argv_sha256": {"$ref": "#/$defs/sha256"},
        "formal_gpu_uuids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^GPU-[0-9A-Za-z-]+$"}
        }
      }
    }
  }
}
