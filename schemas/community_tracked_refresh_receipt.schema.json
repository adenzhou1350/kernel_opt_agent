{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_tracked_refresh_receipt.schema.json",
  "title": "Bounded refresh receipt for PRs referenced by optimization events",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "claim_boundary",
    "authenticated",
    "max_captures",
    "dry_run",
    "tracked_pr_count",
    "captured_count",
    "semantic_change_count",
    "review_required_event_ids",
    "tracked_pull_requests"
  ],
  "properties": {
    "schema_version": {"const": "community-tracked-refresh-receipt-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "TRACKED_SOURCE_REFRESH_ONLY"},
    "authenticated": {"type": "boolean"},
    "max_captures": {"type": "integer", "minimum": 1, "maximum": 100},
    "dry_run": {"type": "boolean"},
    "tracked_pr_count": {"type": "integer", "minimum": 1},
    "captured_count": {"type": "integer", "minimum": 0},
    "semantic_change_count": {"type": "integer", "minimum": 0},
    "review_required_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tracked_pull_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "pr_number",
          "event_ids",
          "decision",
          "before",
          "after",
          "semantic_changed",
          "review_required_event_ids"
        ],
        "properties": {
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "pr_number": {"type": "integer", "minimum": 1},
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "decision": {"enum": ["CAPTURED", "BUDGET_SKIPPED", "DRY_RUN"]},
          "before": {"$ref": "#/$defs/snapshot"},
          "after": {"oneOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]},
          "semantic_changed": {"type": "boolean"},
          "review_required_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "semantic_identity", "lifecycle", "source_available_at"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "semantic_identity": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "lifecycle": {"enum": ["OPEN", "MERGED", "CLOSED_UNMERGED"]},
        "source_available_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
