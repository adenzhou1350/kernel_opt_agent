{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_suite_run_summary.schema.json",
  "title": "Failure-preserving summary of a materialized community A/B schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "claim_boundary", "schedule_identity", "trials", "pairs", "counts"],
  "properties": {
    "schema_version": {"const": "community-suite-run-summary-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "PROTOCOL_COMPLIANCE_AND_OBSERVED_METRICS_ONLY"},
    "schedule_identity": {"$ref": "#/$defs/identity"},
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_index", "task_id", "repeat_index", "arm", "status", "violations", "audit_identity", "assessment_identity", "metrics"],
        "properties": {
          "order_index": {"type": "integer", "minimum": 1},
          "task_id": {"type": "string", "minLength": 1},
          "repeat_index": {"type": "integer", "minimum": 1},
          "arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
          "status": {"enum": ["PASS", "INVALID", "INCOMPLETE"]},
          "violations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "audit_identity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
          "assessment_identity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
          "metrics": {"type": ["object", "null"]}
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "repeat_index", "status", "arm_status"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "repeat_index": {"type": "integer", "minimum": 1},
          "status": {"enum": ["COMPARABLE", "NOT_COMPARABLE"]},
          "arm_status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["CONTROL", "COMMUNITY_AUGMENTED"],
            "properties": {
              "CONTROL": {"enum": ["PASS", "INVALID", "INCOMPLETE"]},
              "COMMUNITY_AUGMENTED": {"enum": ["PASS", "INVALID", "INCOMPLETE"]}
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CONTROL", "COMMUNITY_AUGMENTED"],
      "properties": {
        "CONTROL": {"$ref": "#/$defs/statusCounts"},
        "COMMUNITY_AUGMENTED": {"$ref": "#/$defs/statusCounts"}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "INVALID", "INCOMPLETE"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "INVALID": {"type": "integer", "minimum": 0},
        "INCOMPLETE": {"type": "integer", "minimum": 0}
      }
    }
  }
}
