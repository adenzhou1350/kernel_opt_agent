{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_pr_snapshot.schema.json",
  "title": "Immutable GitHub pull-request evidence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "source",
    "pull_request",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "community-pr-snapshot-v1"},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "number", "html_url", "api_version", "authenticated"],
      "properties": {
        "provider": {"const": "github"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "number": {"type": "integer", "minimum": 1},
        "html_url": {"type": "string", "pattern": "^https://github\\.com/"},
        "api_version": {"type": "string", "minLength": 1},
        "authenticated": {"type": "boolean"}
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "author",
        "state",
        "draft",
        "merged",
        "created_at",
        "updated_at",
        "closed_at",
        "merged_at",
        "base_sha",
        "head_sha",
        "labels"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "state": {"enum": ["open", "closed"]},
        "draft": {"type": "boolean"},
        "merged": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "closed_at": {"type": ["string", "null"]},
        "merged_at": {"type": ["string", "null"]},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "byte_length", "media_type", "source_urls"],
        "properties": {
          "kind": {
            "enum": [
              "PULL_REQUEST",
              "FILES",
              "COMMITS",
              "ISSUE_COMMENTS",
              "REVIEWS",
              "REVIEW_COMMENTS",
              "TIMELINE",
              "DIFF"
            ]
          },
          "path": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^https://"}
          }
        }
      }
    }
  }
}
