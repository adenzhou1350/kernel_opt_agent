{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deterministic_output_observations.schema.json",
  "title": "Deterministic output observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "baseline_arm",
    "candidate_arm",
    "case_ids",
    "repeat_count",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": "deterministic-output-observations-v1"},
    "contract": {"$ref": "#/$defs/identity"},
    "baseline_arm": {"type": "string", "minLength": 1},
    "candidate_arm": {"type": "string", "minLength": 1},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repeat_count": {"type": "integer", "minimum": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm", "repeat_index", "case_id", "output_sha256"],
        "properties": {
          "arm": {"type": "string", "minLength": 1},
          "repeat_index": {"type": "integer", "minimum": 0},
          "case_id": {"type": "string", "minLength": 1},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
