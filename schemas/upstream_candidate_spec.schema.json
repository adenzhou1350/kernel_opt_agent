{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstream_candidate_spec.schema.json",
  "title": "Evidence-bound upstream candidate specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "repository",
    "motivation",
    "modifications",
    "accuracy_summary",
    "tests",
    "benchmark_claims",
    "evidence",
    "boundaries",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "upstream-candidate-spec-v1"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "base_branch", "base_commit", "candidate_branch", "candidate_commit"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "title": {"type": "string", "minLength": 1},
        "base_branch": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_branch": {"type": "string", "minLength": 1},
        "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "motivation": {"type": "string", "minLength": 1},
    "modifications": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accuracy_summary": {"type": "string", "minLength": 1},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence_path"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "evidence_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "benchmark_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/benchmark_claim"}
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "gates": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "rationale"],
        "properties": {
          "name": {"enum": ["correctness", "source_review", "whole_model_performance", "upstream_checks", "cross_hardware"]},
          "status": {"enum": ["PASS", "PENDING", "FAIL"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"enum": ["CORRECTNESS", "OPERATOR_PERFORMANCE", "WHOLE_MODEL_PERFORMANCE", "ENVIRONMENT", "REPRODUCTION", "UPSTREAM_CHECKS", "CROSS_HARDWARE"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "benchmark_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "workload", "metric", "direction", "baseline", "candidate", "unit", "speedup", "evidence_path"],
      "properties": {
        "scope": {"enum": ["OPERATOR", "WHOLE_MODEL"]},
        "workload": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "direction": {"enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER"]},
        "baseline": {"type": "number", "exclusiveMinimum": 0},
        "candidate": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "speedup": {"type": "number", "exclusiveMinimum": 0},
        "evidence_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
