{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community phase command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_boundary",
    "cycle_id",
    "task_id",
    "span_id",
    "phase",
    "actor",
    "resource_id",
    "started_at",
    "ended_at",
    "duration_seconds",
    "working_directory",
    "command",
    "timeout_seconds",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "community-phase-command-receipt-v1"},
    "claim_boundary": {"const": "COMMAND_WALL_TIME_AND_EXIT_STATUS_NOT_RESULT_CORRECTNESS"},
    "cycle_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "span_id": {"type": "string", "minLength": 1},
    "phase": {
      "enum": [
        "COMMUNITY_RESEARCH",
        "BOTTLENECK_DIAGNOSIS",
        "CANDIDATE_IMPLEMENTATION",
        "COMPILE_AND_MEASURE",
        "CORRECTNESS_VALIDATION",
        "PERFORMANCE_VALIDATION",
        "WHOLE_MODEL_VALIDATION",
        "UPSTREAM_PACKAGING",
        "ENVIRONMENT_SETUP",
        "GOVERNANCE_VALIDATION",
        "EXTERNAL_WAIT",
        "UNATTRIBUTED_LEGACY_WORK"
      ]
    },
    "actor": {"enum": ["AGENT", "CPU", "GPU", "EXTERNAL"]},
    "resource_id": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "working_directory": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "span_status", "error"],
      "properties": {
        "status": {"enum": ["PASS", "COMMAND_FAILED", "TIMED_OUT", "LAUNCH_FAILED"]},
        "exit_code": {"type": "integer"},
        "span_status": {"enum": ["COMPLETE", "INTERRUPTED"]},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
