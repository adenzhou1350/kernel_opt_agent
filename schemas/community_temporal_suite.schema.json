{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_temporal_suite.schema.json",
  "title": "Leakage-resistant fixed-budget community-knowledge evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "cutoff_at",
    "claim_boundary",
    "training_graph",
    "protocol",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "community-temporal-suite-v1"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "EVALUATION_PROTOCOL_ONLY"},
    "training_graph": {"$ref": "#/$defs/identity"},
    "training_methods": {"$ref": "#/$defs/identity"},
    "training_prior_outcomes": {"$ref": "#/$defs/identity"},
    "training_prior_routing": {"$ref": "#/$defs/identity"},
    "preselection_anchor": {"$ref": "#/$defs/identity"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arms",
        "repeats",
        "randomized_order",
        "random_seed",
        "network_policy",
        "model_identity",
        "prompt_identity",
        "environment_identity",
        "budgets",
        "minimum_material_speedup",
        "metrics"
      ],
      "properties": {
        "arms": {"const": ["CONTROL", "COMMUNITY_AUGMENTED"]},
        "repeats": {"type": "integer", "minimum": 1},
        "randomized_order": {"const": true},
        "random_seed": {"type": "integer", "minimum": 0},
        "network_policy": {"const": "DISABLED_AFTER_MATERIALIZATION"},
        "model_identity": {"type": "string", "minLength": 1},
        "prompt_identity": {"$ref": "#/$defs/identity"},
        "environment_identity": {"$ref": "#/$defs/identity"},
        "task_packet_contract": {
          "type": "string",
          "enum": ["LEGACY_UNSCHEMATIZED", "STRICT_V2", "STRICT_V3"]
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_clock_seconds",
            "max_command_seconds",
            "max_candidates",
            "max_compile_attempts",
            "max_measurements",
            "max_technical_repairs",
            "max_causal_revisions"
          ],
          "properties": {
            "wall_clock_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_command_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_candidates": {"type": "integer", "minimum": 1},
            "max_compile_attempts": {"type": "integer", "minimum": 0},
            "max_measurements": {"type": "integer", "minimum": 0},
            "max_technical_repairs": {"type": "integer", "minimum": 0},
            "max_causal_revisions": {"type": "integer", "minimum": 0}
          }
        },
        "minimum_material_speedup": {"type": "number", "exclusiveMinimum": 1},
        "metrics": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TIME_TO_FIRST_CORRECT",
              "TIME_TO_FIRST_IMPROVEMENT",
              "BEST_SPEEDUP",
              "ARCHITECTURE_FAMILY_COVERAGE",
              "HELDOUT_CORRECTNESS",
              "WHOLE_MODEL_SPEEDUP",
              "UPSTREAM_READINESS"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {"required": ["pr_number"], "not": {"required": ["prospective_id"]}},
          {"required": ["prospective_id"], "not": {"required": ["pr_number"]}}
        ],
        "required": [
          "task_id",
          "available_at",
          "repository",
          "base_revision",
          "target_hardware",
          "packet",
          "hidden_oracle"
        ],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "available_at": {"type": "string", "format": "date-time"},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "pr_number": {"type": "integer", "minimum": 1},
          "prospective_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "target_hardware": {"type": "string", "minLength": 1},
          "packet": {"$ref": "#/$defs/identity"},
          "hidden_oracle": {"$ref": "#/$defs/identity"},
          "prior_context_distinction": {"$ref": "#/$defs/identity"},
          "support": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "target"],
              "properties": {
                "source": {"$ref": "#/$defs/identity"},
                "target": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
