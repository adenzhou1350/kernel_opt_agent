{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_coverage_policy.schema.json",
  "title": "Frozen community knowledge coverage requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "required_outcomes",
    "required_repositories",
    "required_relation_types",
    "minimum_reviewed_fraction",
    "minimum_negative_event_count",
    "minimum_cross_repository_compositions",
    "maximum_unresolved_relation_fraction",
    "maximum_single_repository_node_fraction"
  ],
  "properties": {
    "schema_version": {"const": "community-coverage-policy-v1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "required_outcomes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "required_repositories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "required_relation_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "minimum_reviewed_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "minimum_negative_event_count": {"type": "integer", "minimum": 0},
    "minimum_cross_repository_compositions": {"type": "integer", "minimum": 0},
    "maximum_unresolved_relation_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "maximum_single_repository_node_fraction": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
