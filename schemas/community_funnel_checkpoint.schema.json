{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_funnel_checkpoint.schema.json",
  "title": "Hash-bound prefix checkpoint for fast community funnel validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "claim_boundary",
    "input_identity",
    "state",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "community-funnel-checkpoint-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "FAST_PREFIX_VALIDATION_NOT_RELEASE_EVIDENCE"},
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_funnel", "corpus_index", "audit_prefix", "source_root"],
      "properties": {
        "source_funnel": {"$ref": "#/$defs/identity"},
        "corpus_index": {"$ref": "#/$defs/identity"},
        "source_root": {"type": "string", "minLength": 1},
        "audit_prefix": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique_candidate_keys", "prefix_identity_closure"],
      "properties": {
        "unique_candidate_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[1-9][0-9]*$"}
        },
        "prefix_identity_closure": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "extension_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_checkpoint", "suffix_audits"],
      "properties": {
        "predecessor_checkpoint": {"$ref": "#/$defs/identity"},
        "suffix_audits": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
