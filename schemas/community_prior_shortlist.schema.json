{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_prior_shortlist.schema.json",
  "title": "Task-specific cutoff-safe community prior shortlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "claim_boundary", "inputs", "policy", "events", "methods", "rejections"],
  "properties": {
    "schema_version": {"const": "community-prior-shortlist-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "DISCOVERY_PRIOR_ONLY"},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "environment", "graph", "methods"],
      "properties": {
        "task": {"$ref": "#/$defs/identity"},
        "environment": {"$ref": "#/$defs/identity"},
        "graph": {"$ref": "#/$defs/identity"},
        "methods": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "prior_outcomes": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "prior_context_distinction": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_events", "max_methods", "minimum_token_hits", "hard_gate_policy"],
      "properties": {
        "max_events": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_methods": {"type": "integer", "minimum": 0, "maximum": 3},
        "minimum_token_hits": {"type": "integer", "minimum": 1},
        "hard_gate_policy": {"const": "FAIL_CLOSED"},
        "outcome_adjustments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["UPRANK", "DOWNRANK", "UNCHANGED", "REQUIRE_CONTEXT_GUARD"],
          "properties": {
            "UPRANK": {"const": 1.0},
            "DOWNRANK": {"const": -1.0},
            "UNCHANGED": {"const": 0.0},
            "REQUIRE_CONTEXT_GUARD": {"const": 0.0}
          }
        }
      }
    },
    "events": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/match"}},
    "methods": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/match"}},
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation", "top_event_id", "top_event_score", "top_method_id", "top_method_score", "rationale"],
      "properties": {
        "recommendation": {"enum": ["CONSULT_BEFORE_FIRST_CANDIDATE", "DEFER_UNTIL_LOCAL_GAP", "NO_RELEVANT_PRIOR"]},
        "top_event_id": {"type": ["string", "null"]},
        "top_event_score": {"type": ["number", "null"], "minimum": 0},
        "top_method_id": {"type": ["string", "null"]},
        "top_method_score": {"type": ["number", "null"], "minimum": 0},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "rejections": {
      "type": "object", "additionalProperties": false,
      "required": ["event_hard_gate", "event_low_relevance", "method_hard_gate", "method_low_relevance"],
      "properties": {
        "event_hard_gate": {"type": "integer", "minimum": 0},
        "event_low_relevance": {"type": "integer", "minimum": 0},
        "event_prior_guard": {"type": "integer", "minimum": 0},
        "method_hard_gate": {"type": "integer", "minimum": 0},
        "method_low_relevance": {"type": "integer", "minimum": 0},
        "method_prior_guard": {"type": "integer", "minimum": 0},
        "method_provenance_gate": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "score", "matched_terms", "record"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "base_score": {"type": "number", "minimum": 0},
        "score": {"type": "number", "minimum": 0},
        "matched_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prior_outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routing_adjustment", "score_delta", "observation_count", "task_count", "heldout_loss_count", "context_distinction_applied"],
          "properties": {
            "routing_adjustment": {"enum": ["NO_EVIDENCE", "REQUIRE_CONTEXT_GUARD", "DOWNRANK", "UPRANK", "UNCHANGED"]},
            "score_delta": {"type": "number"},
            "observation_count": {"type": "integer", "minimum": 0},
            "task_count": {"type": "integer", "minimum": 0},
            "heldout_loss_count": {"type": "integer", "minimum": 0},
            "context_distinction_applied": {"type": "boolean"}
          }
        },
        "record": {"type": "object"}
      }
    }
  }
}
