{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification_pipeline_canary_result.schema.json",
  "title": "Producer-to-consumer compatibility canary result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "status", "claim_boundary", "spec", "artifact_root", "stages", "pipeline_compatible", "execution_authorized", "performance_claim_created"],
  "properties": {
    "schema_version": {"const": "qualification-pipeline-canary-result-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "FAIL"]},
    "claim_boundary": {"const": "DRY_RUN_COMPATIBILITY_ONLY_NOT_EXECUTION_AUTHORIZATION_OR_PERFORMANCE_EVIDENCE"},
    "spec": {"$ref": "#/$defs/specIdentity"},
    "artifact_root": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "cwd", "exit_code", "timed_out", "duration_ms", "stdout_sha256", "stderr_sha256", "outputs", "status", "error"],
        "properties": {
          "id": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "exit_code": {"type": ["integer", "null"]},
          "timed_out": {"type": "boolean"},
          "duration_ms": {"type": "number", "minimum": 0},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"},
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "bytes", "freshness", "previous_sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "bytes": {"type": "integer", "minimum": 0},
                "freshness": {"enum": ["PRESENT", "CREATED_OR_CHANGED"]},
                "previous_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
              }
            }
          },
          "status": {"enum": ["PASS", "FAIL"]},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "pipeline_compatible": {"type": "boolean"},
    "execution_authorized": {"const": false},
    "performance_claim_created": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
