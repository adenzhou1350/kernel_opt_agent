{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_contract.schema.json",
  "title": "Candidate-first decision contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "status", "issued_by", "objective_identity",
    "frontier_identity", "candidate_bindings", "top_two_candidate_ids",
    "decision_metric", "measurement_need", "experiment_budget", "stop_rules", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "decision-contract-v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "READY_FOR_SUPERVISOR", "APPROVED", "REPLAN_REQUIRED", "CLOSED"]},
    "issued_by": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "owner_id"],
      "properties": {
        "role": {"const": "GLOBAL_SCHEDULER"},
        "owner_id": {"type": "string", "minLength": 1}
      }
    },
    "objective_identity": {"$ref": "#/$defs/identity"},
    "frontier_identity": {"$ref": "#/$defs/identity"},
    "candidate_bindings": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "artifact_identity", "predicted_objective"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "artifact_identity": {"$ref": "#/$defs/identity"},
          "predicted_objective": {"$ref": "#/$defs/interval"}
        }
      }
    },
    "top_two_candidate_ids": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unit", "direction"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["minimize", "maximize"]}
      }
    },
    "measurement_need": {
      "type": "object", "additionalProperties": false,
      "required": [
        "quantity_id", "model_location", "equation", "current_interval",
        "top_two_delta_interval", "decision_boundary", "required_precision",
        "outcome_mapping", "maximum_decision_value", "decision_flip_probability",
        "expected_uncertainty_reduction"
      ],
      "properties": {
        "quantity_id": {"type": "string", "minLength": 1},
        "model_location": {"type": "string", "minLength": 1},
        "equation": {"type": "string", "minLength": 1},
        "current_interval": {"$ref": "#/$defs/interval"},
        "top_two_delta_interval": {"$ref": "#/$defs/interval"},
        "decision_boundary": {"$ref": "#/$defs/quantity"},
        "required_precision": {"$ref": "#/$defs/positive_quantity"},
        "outcome_mapping": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "maximum_decision_value": {"$ref": "#/$defs/positive_quantity"}
        ,"decision_flip_probability": {"type": "number", "minimum": 0, "maximum": 1}
        ,"expected_uncertainty_reduction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "experiment_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["screening", "qualification", "max_revisions"],
      "properties": {
        "screening": {"$ref": "#/$defs/budget"},
        "qualification": {"$ref": "#/$defs/budget"},
        "max_revisions": {"type": "integer", "minimum": 0}
      }
    },
    "stop_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array"}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": true,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "quantity": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "positive_quantity": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["lower", "upper", "unit"],
      "properties": {
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_configurations", "max_samples_per_configuration", "max_process_launches", "max_wall_clock_minutes"],
      "properties": {
        "max_configurations": {"type": "integer", "minimum": 1},
        "max_samples_per_configuration": {"type": "integer", "minimum": 1},
        "max_process_launches": {"type": "integer", "minimum": 1},
        "max_wall_clock_minutes": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
