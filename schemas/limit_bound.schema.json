{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "limit_bound.schema.json",
  "title": "Per-workload evidence-bound performance limit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "workload_identity", "objective", "cases"],
  "properties": {
    "schema_version": {"const": "limit-bound-v1"},
    "kind": {"enum": ["SILICON_LOWER", "RESOURCE_SERVICE_LOWER", "DEPENDENCY_DAG_LOWER", "FEASIBLE_SCHEDULE_UPPER"]},
    "status": {"const": "VALID"},
    "workload_identity": {"type": "object"},
    "objective": {
      "type": "object",
      "required": ["metric", "unit", "direction", "statistic"],
      "properties": {"unit": {"const": "us"}, "direction": {"const": "minimize"}}
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "bound_us", "confidence", "derivation", "evidence"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "bound_us": {"type": "number", "minimum": 0},
          "confidence": {
            "type": "object",
            "required": ["level", "lower_us", "upper_us"]
          },
          "derivation": {"type": "object"},
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
