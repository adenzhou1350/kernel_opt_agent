{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_graph_publication.schema.json",
  "title": "Fail-closed publication receipt for the current community graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "published_at", "state", "claim_boundary",
    "graph", "corpus_index", "repository_universe", "validation"
  ],
  "properties": {
    "schema_version": {"const": "community-graph-publication-v1"},
    "published_at": {"type": "string", "format": "date-time"},
    "state": {"const": "CURRENT_GRAPH_VALIDATED_AT_PUBLICATION"},
    "claim_boundary": {"const": "ATTACH_TIME_FRESHNESS_EVIDENCE_NOT_HISTORICAL_GRAPH_REWRITE"},
    "graph": {"$ref": "#/$defs/identity"},
    "corpus_index": {"$ref": "#/$defs/identity"},
    "repository_universe": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "node_count", "edge_count", "coverage_gap_count", "composition_count", "lifecycle_review_count"],
      "properties": {
        "status": {"const": "PASS"},
        "node_count": {"type": "integer", "minimum": 1},
        "edge_count": {"type": "integer", "minimum": 0},
        "coverage_gap_count": {"type": "integer", "minimum": 0},
        "composition_count": {"type": "integer", "minimum": 0},
        "lifecycle_review_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
