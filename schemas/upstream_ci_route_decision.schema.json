{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstream_ci_route_decision.schema.json",
  "title": "Fail-closed upstream CI routing decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "snapshot", "repository", "pull_request_number", "head_sha", "draft", "counts", "github_ci_stage", "candidate_test_failure", "only_policy_gate_failures", "recommended_action", "external_action_owner", "classified_checks", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "upstream-ci-route-decision-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "snapshot": {"$ref": "#/$defs/identity"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "draft": {"type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "skipped", "running", "policy_gate", "candidate_failure", "infrastructure_failure", "unknown_failure"],
      "properties": {
        "success": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "policy_gate": {"type": "integer", "minimum": 0},
        "candidate_failure": {"type": "integer", "minimum": 0},
        "infrastructure_failure": {"type": "integer", "minimum": 0},
        "unknown_failure": {"type": "integer", "minimum": 0}
      }
    },
    "github_ci_stage": {"enum": ["PASS", "RUNNING", "POLICY_GATE", "INFRASTRUCTURE_FAILURE", "UNKNOWN_FAILURE", "CANDIDATE_FAILURE"]},
    "candidate_test_failure": {"type": "boolean"},
    "only_policy_gate_failures": {"type": "boolean"},
    "recommended_action": {"enum": ["CI_PASS", "WAIT_FOR_CHECK_COMPLETION", "KEEP_DRAFT_AND_WAIT", "WAIT_FOR_MAINTAINER_CI_AUTHORIZATION", "ROUTE_INFRASTRUCTURE_FAILURE", "INSPECT_FAILED_CHECKS", "RESPOND_TO_CANDIDATE_FAILURE"]},
    "external_action_owner": {"enum": ["AUTHOR", "MAINTAINER", "CONTROL_PLANE"]},
    "classified_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "name", "classification", "details_url"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "classification": {"enum": ["SUCCESS", "SKIPPED", "RUNNING", "POLICY_GATE", "INFRASTRUCTURE_FAILURE", "UNKNOWN_FAILURE", "CANDIDATE_FAILURE"]},
          "details_url": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_boundary": {"const": "ROUTING_ONLY_NO_CI_RERUN_COMMENT_READY_TRANSITION_OR_MERGE_AUTHORIZATION"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
