{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstream_ci_snapshot.schema.json",
  "title": "Public upstream pull-request CI snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "pull_request_number", "head_sha", "draft", "observed_at", "source", "observed_check_count", "checks"],
  "properties": {
    "schema_version": {"const": "upstream-ci-snapshot-v1"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "draft": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {"enum": ["GITHUB_PUBLIC_API", "GITHUB_PUBLIC_UI"]},
    "observed_check_count": {"type": "integer", "minimum": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "name", "status", "conclusion", "details_url", "evidence_lines"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["COMPLETED", "IN_PROGRESS", "QUEUED"]},
          "conclusion": {"type": ["string", "null"], "enum": ["SUCCESS", "FAILURE", "CANCELLED", "SKIPPED", "NEUTRAL", "TIMED_OUT", "ACTION_REQUIRED", null]},
          "details_url": {"type": "string", "minLength": 1},
          "evidence_lines": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
