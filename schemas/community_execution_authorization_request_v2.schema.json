{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_execution_authorization_request_v2.schema.json",
  "title": "Semantic-approval-ready request for one frozen community cohort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "approval_expires_at", "request_id",
    "cycle_id", "claim_boundary", "pre_gpu_gate", "execution_contract_gate",
    "cohort", "suite", "formal_resource_id", "tasks", "schedule",
    "supervisor_registry", "role_artifacts", "execution_budget",
    "contract_bindings", "approval_scope_sha256", "single_use_token",
    "hidden_oracle_exposed"
  ],
  "properties": {
    "schema_version": {"const": "community-execution-authorization-request-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "approval_expires_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "claim_boundary": {"const": "SEMANTIC_APPROVAL_REQUEST_NOT_AUTHORIZATION_OR_TOKEN_CONSUMPTION"},
    "pre_gpu_gate": {"$ref": "#/$defs/identity"},
    "execution_contract_gate": {"$ref": "#/$defs/identity"},
    "cohort": {"$ref": "#/$defs/identity"},
    "suite": {"$ref": "#/$defs/identity"},
    "formal_resource_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/task"}
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/schedule_entry"}
    },
    "supervisor_registry": {"$ref": "#/$defs/identity"},
    "role_artifacts": {"$ref": "#/$defs/role_artifacts"},
    "execution_budget": {"$ref": "#/$defs/identity"},
    "contract_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/contract_binding"}
    },
    "approval_scope_sha256": {"$ref": "#/$defs/sha256"},
    "single_use_token": {"$ref": "#/$defs/sha256"},
    "hidden_oracle_exposed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "role_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "analyst", "experimenter"],
      "properties": {
        "scheduler": {"$ref": "#/$defs/identity"},
        "analyst": {"$ref": "#/$defs/identity"},
        "experimenter": {"$ref": "#/$defs/identity"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "experimenter_id", "formal_gpu_uuids", "sealed_argv"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "experimenter_id": {"type": "string", "minLength": 1},
        "formal_gpu_uuids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^GPU-[0-9A-Za-z-]+$"}
        },
        "sealed_argv": {"$ref": "#/$defs/identity"}
      }
    },
    "schedule_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_index", "task_id", "repeat_index", "arm", "schedule_key"],
      "properties": {
        "order_index": {"type": "integer", "minimum": 1},
        "task_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1},
        "arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
        "schedule_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "decision_contract", "measurability_contract", "frontier", "objective"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "decision_contract": {"$ref": "#/$defs/identity"},
        "measurability_contract": {"$ref": "#/$defs/identity"},
        "frontier": {"$ref": "#/$defs/identity"},
        "objective": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
