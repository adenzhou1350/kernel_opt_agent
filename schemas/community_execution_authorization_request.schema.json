{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community_execution_authorization_request.schema.json",
  "title": "Frozen request for one community cohort execution authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "cycle_id", "claim_boundary",
    "pre_gpu_gate", "execution_contract_gate", "cohort", "suite",
    "formal_resource_id", "tasks", "schedule", "hidden_oracle_exposed"
  ],
  "properties": {
    "schema_version": {"const": "community-execution-authorization-request-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cycle_id": {"type": "string", "minLength": 1},
    "claim_boundary": {"const": "FROZEN_DISPATCH_REQUEST_NOT_AUTHORIZATION_OR_EXECUTION"},
    "pre_gpu_gate": {"$ref": "#/$defs/identity"},
    "execution_contract_gate": {"$ref": "#/$defs/identity"},
    "cohort": {"$ref": "#/$defs/identity"},
    "suite": {"$ref": "#/$defs/identity"},
    "formal_resource_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/task"}
    },
    "schedule": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/schedule_entry"}
    },
    "hidden_oracle_exposed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.).+"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "formal_gpu_uuids", "sealed_argv"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "formal_gpu_uuids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^GPU-[0-9A-Za-z-]+$"}
        },
        "sealed_argv": {"$ref": "#/$defs/identity"}
      }
    },
    "schedule_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["order_index", "task_id", "repeat_index", "arm", "schedule_key"],
      "properties": {
        "order_index": {"type": "integer", "minimum": 1},
        "task_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1},
        "arm": {"enum": ["CONTROL", "COMMUNITY_AUGMENTED"]},
        "schedule_key": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
