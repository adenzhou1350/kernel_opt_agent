{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executable_experiment.schema.json",
  "title": "Materialized model-driven experiment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "request_id", "status", "question", "model_update_contract",
    "source", "commands", "parameter_matrix", "controls", "measurement_contract",
    "decision_contract_identity", "measurability_contract_identity",
    "experiment_class", "tested_candidate_ids", "prepared_by", "execution_budget",
    "expected_sass", "artifacts", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "executable-experiment-v1"},
    "status": {"enum": ["PLANNED", "MATERIALIZED", "RUNNING", "COMPLETE", "BLOCKED", "AWAITING_SUPERVISOR_REVIEW", "HALT_AND_REPLAN"]},
    "request_id": {"type": "string", "minLength": 1},
    "commands": {
      "type": "object",
      "required": ["clean_build", "static_audit", "correctness", "warmup", "measure", "analyze"]
    },
    "parameter_matrix": {"type": "array", "minItems": 1},
    "decision_contract_identity": {"type": "object", "required": ["path", "sha256"]},
    "measurability_contract_identity": {"type": "object", "required": ["path", "sha256"]},
    "experiment_class": {"enum": ["SCREENING", "QUALIFICATION"]},
    "tested_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prepared_by": {
      "type": "object", "required": ["role", "actor_id"],
      "properties": {"role": {"const": "EXPERIMENT_AGENT"}, "actor_id": {"type": "string", "minLength": 1}}
    },
    "execution_budget": {
      "type": "object",
      "required": ["samples_per_configuration", "process_launches", "max_wall_clock_minutes"]
    },
    "controls": {"type": "array", "minItems": 1},
    "expected_sass": {"type": "array", "minItems": 1},
    "artifacts": {"type": "object"},
    "evidence": {"type": "array"}
  }
}
